{
  "name": "receita-recipes-app",
  "version": "2.0.0",
  "private": true,
  "description": "RecEITA! — a mobile-first recipe explorer built with React. Browse, search and filter meals and cocktails, follow step-by-step cooking progress, and keep your favourites and finished dishes in one place.",
  "keywords": [
    "react",
    "recipe-app",
    "recipes",
    "cocktails",
    "themealdb",
    "thecocktaildb",
    "frontend",
    "context-api",
    "react-hooks",
    "react-router",
    "responsive-design",
    "pwa"
  ],
  "author": "Michael Robert <https://github.com/michaelrobertt>",
  "contributors": [
    "Antonio Marchiori <https://github.com/acmarchiori>",
    "Igor Alegria <https://github.com/IgorAlegria>",
    "Gleidson <https://github.com/GleidsonDev>",
    "Elvine Santos"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelrobertt/RecipesApp.git"
  },
  "bugs": {
    "url": "https://github.com/michaelrobertt/RecipesApp/issues"
  },
  "homepage": "https://receita.surge.sh",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/postbuild.js",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "lint": "eslint src --ext .js,.jsx",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "history": "^4.10.1",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "src/index.js",
      "src/tests"
    ]
  }
}
